# Development runs on MockLLM at $0. Set these only for live Gemini/Vertex.
CF_USE_GEMINI=0
GEMINI_API_KEY=
# Vertex (ADC / workload identity). Proposer + answer only — never ACT/CLARIFY.
CF_USE_VERTEX=0
GCP_PROJECT=
GCP_REGION=asia-south1
CF_GEN_MODEL=gemini-2.0-flash
CF_LITE_MODEL=gemini-2.0-flash-lite
CF_EMBED_MODEL=text-embedding-004
CF_MODE=split
# Optional: LLM extractor (Ollama/Gemini generate JSON). Default mock = no-op extract.
CF_LLM_EXTRACT=0
# Memory backend: memory (default, local tests) | firestore (durable POC)
CF_MEMORY_BACKEND=memory
CF_FIRESTORE_DATABASE=(default)
# Optional: seed A/B/C/D cards for smoke (not production default).
CF_SEED_ABCD=0
# Demo labeling for presentation Cloud Run
CF_DEMO_ONLY=0
# Optional local Ollama (no cloud). Tests must not require this.
CF_USE_OLLAMA=0
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
